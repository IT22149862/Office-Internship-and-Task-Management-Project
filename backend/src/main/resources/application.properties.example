spring.application.name=internship-management-system

# ===== MongoDB =====
# Local install:  mongodb://localhost:27017/internship_management
# Atlas cluster:  mongodb+srv://<username>:<password>@<cluster-url>/internship_management
spring.data.mongodb.uri=mongodb://localhost:27017/internship_management

# ===== Server =====
server.port=8080

# ===== JWT =====
# Use a long, random string (32+ characters). Never reuse this example value.
app.jwt.secret=replace-with-a-long-random-string-at-least-32-characters
app.jwt.expiration-ms=86400000

# ===== Default admin seed account =====
# Created automatically on first boot if no admin account exists yet.
app.seed.admin-name=System Administrator
app.seed.admin-email=example.com
app.seed.admin-password=ChangeThisPassword123!

# ===== Jackson =====
spring.jackson.default-property-inclusion=non_null

# ===== CORS =====
# Must match the URL your frontend runs on.
app.cors.allowed-origin=http://localhost:5173
