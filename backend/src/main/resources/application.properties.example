spring.application.name=internship-management-system

spring.data.mongodb.uri=${MONGODB_URI:mongodb://localhost:27017/internship_management}

server.port=${SERVER_PORT:8080}

app.jwt.secret=${JWT_SECRET:change-this-in-application-local.properties}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}

app.seed.admin-name=${SEED_ADMIN_NAME:System Administrator}
app.seed.admin-email=${SEED_ADMIN_EMAIL:admin@internship.local}
app.seed.admin-password=${SEED_ADMIN_PASSWORD:Admin@12345}

spring.jackson.default-property-inclusion=non_null

app.cors.allowed-origin=${CORS_ALLOWED_ORIGIN:http://localhost:5173}