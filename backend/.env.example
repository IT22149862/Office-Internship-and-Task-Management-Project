# Copy this file to .env (or export as real environment variables) and fill in real values.
# Never commit the real .env file.

MONGODB_URI=mongodb://localhost:27017/internship_management
SERVER_PORT=8080

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@internship.local
SEED_ADMIN_PASSWORD=Admin@12345

CORS_ALLOWED_ORIGIN=http://localhost:5173
